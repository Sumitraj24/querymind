# QueryMind AI — server-side configuration.
# Copy to .env.local for local development. Never commit real values.
# None of these are exposed to the browser (no NEXT_PUBLIC_ prefix).

# --- AI model (FreeLLMAPI, OpenAI-compatible) --------------------------------
# Base URL including /v1. Local FreeLLMAPI runs on port 3001 by default.
# A deployed site cannot reach "localhost" on your computer: use a URL your
# server can reach (see README, "Deploying").
FREELLMAPI_BASE_URL=http://localhost:3001/v1
# Your unified key from the FreeLLMAPI dashboard (Keys page). Starts with "freellmapi-".
FREELLMAPI_API_KEY=
# "auto" lets FreeLLMAPI's router choose (also "auto:fast", "auto:smart", or a model id).
FREELLMAPI_MODEL=auto
# Request timeout for the model in milliseconds (5000-120000).
FREELLMAPI_TIMEOUT_MS=45000

# --- Your database (optional) --------------------------------------------------
# PostgreSQL connection string for a READ-ONLY user. Leave empty to use demo mode
# (built-in sample data, clearly labelled in the app).
# Example: postgresql://querymind_readonly:password@localhost:5432/mydb
# For hosted databases you usually need ?sslmode=require
DATABASE_URL=
DATABASE_DIALECT=postgresql

# --- Query limits -------------------------------------------------------------
QUERY_MAX_ROW_LIMIT=500
QUERY_TIMEOUT_MS=10000

# --- Development only -----------------------------------------------------------
# Print generated SQL to the server console while developing. Ignored in production.
QUERYMIND_DEBUG_SQL=false
